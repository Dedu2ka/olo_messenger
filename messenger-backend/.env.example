# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MESSAGE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_EXACTLY_32_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional until Firebase Cloud Messaging is configured.
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase/service-account.json
